# ============================================
# BookHub - Environment Variables
# Copy to .env and fill in your values
# ============================================

# ---- Database ----
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_NAME=bookhub
DB_PORT=5432

# ---- Backend ----
BACKEND_PORT=8082
SPRING_PROFILE=prod
JWT_SECRET=replace-with-a-secure-random-string-at-least-256-bits
DEV_MODE=false

# ---- Email ----
EMAIL_ENABLED=false
EMAIL_FROM=noreply@bookhub.com

# ---- Frontend ----
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8082
